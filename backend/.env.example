DATABASE_URL=
APP_ENV=development
MAX_UPLOAD_SIZE_BYTES=10485760
# Lets requests set "now" with an X-Test-Clock header (evaluation only, never production).
ALLOW_TEST_CLOCK=false
# Upload limits: requests per minute per client IP, and files per request.
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MAX_FILES_PER_UPLOAD=10
# Browser origins allowed to call the API, comma-separated (no '*').
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
